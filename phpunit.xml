<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="src/bootstrap.php">
	<testsuites>
		<testsuite name="Unit">
			<directory suffix="Test.php">src</directory>
		</testsuite>
	</testsuites>

	<source>
		<include>
			<directory suffix=".php">src</directory>
		</include>
		<exclude>
			<directory suffix="Test.php">src</directory>
			<directory suffix="TestStub.php">src</directory>
			<directory suffix=".php">src/cmd</directory>
		</exclude>
	</source>

	<coverage>
		<report>
			<html outputDirectory="coverage/" />
			<text outputFile="php://stdout" showOnlySummary="true" />
		</report>
	</coverage>

	<php>
		<env name="APP_ENV" value="testing" />

		<!-- JWT para email -->
		<env name="OS_EMAIL_ACTION_TOKEN_SECRET" value="76e6b65cb21af891fa8dbb9cde79c8d5a5e87070d3f5532687f670fd658237d8" force="true" />
	</php>
</phpunit>
