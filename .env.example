# ================================
# Banco de Dados
# ================================
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_HOST=mysql
DB_PORT=3306

# ================================
# Aplicação
# ================================
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# ================================
# JWT
# ================================
JWT_SECRET=SECRET_INSEGURO_TROCAR
