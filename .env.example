JWT_TTL=3600

# ================================
# JWT - Ordem Serviço
# ================================
JWT_SECRET_ORDEM_SERVICO=SECRET_INSEGURO_TROCAR
JWT_TTL_ORDEM_SERVICO=3600
JWT_ISSUER_ORDEM_SERVICO=tech-challenge-api
