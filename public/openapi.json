{
    "openapi": "3.0.0",
    "info": {
        "title": "API Tech Chalange",
        "description": "API documentation",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Development"
        }
    ],
    "paths": {
        "/clientes/": {
            "get": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Listar clientes cadastrados",
                "operationId": "listarClientes",
                "responses": {
                    "200": {
                        "description": "Lista de clientes encontrados",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListarClientesResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/clientes/{id}": {
            "get": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Obtém um cliente pelo id",
                "operationId": "obterCliente",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cliente encontrado"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "operationId": "201854cbe75f77b848d6231b2dc72dc3",
                "responses": {
                    "200": {
                        "description": "Servidor está funcionando"
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "ClienteResponse": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 123
                    },
                    "nome": {
                        "type": "string",
                        "example": "Fulano de Tal"
                    },
                    "cpf_cnpj": {
                        "type": "string",
                        "example": "12*.***.***-89"
                    },
                    "email": {
                        "type": "string",
                        "example": "fu********@example.com"
                    },
                    "telefone": {
                        "type": "string",
                        "example": "*********78"
                    }
                },
                "type": "object"
            },
            "ListarClientesResponse": {
                "properties": {
                    "clientes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ClienteResponse"
                        }
                    }
                },
                "type": "object"
            },
            "ValidationError": {},
            "ValidationErrorResponse": {
                "properties": {
                    "errors": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        }
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "tags": [
        {
            "name": "Clientes",
            "description": "Clientes"
        },
        {
            "name": "Health",
            "description": "Health"
        }
    ]
}