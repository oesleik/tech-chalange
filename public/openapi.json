            "post": {
                "tags": [
                    "Estoque"
                ],
                "summary": "Registrar entrada de peças no estoque",
                "operationId": "890a747856565438e48614ac9db810bd",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EntradaEstoqueRequest"
