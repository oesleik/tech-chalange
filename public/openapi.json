    "components": {
        "schemas": {
            "ClienteResponse": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 123
                    },
                    "nome": {
                        "type": "string",
                        "example": "Fulano de Tal"
                    },
                    "cpf_cnpj": {
                        "type": "string",
                        "example": "12*.***.***-89"
                    },
                    "email": {
                        "type": "string",
                        "example": "fu********@example.com"
                    },
                    "telefone": {
                        "type": "string",
                        "example": "*********78"
                    }
                },
                "type": "object"
            },
            "CriarClienteRequest": {
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Fulano de Tal"
                    },
                    "cpf_cnpj": {
                        "type": "string",
                        "example": "123.456.789-89"
                    },
                    "email": {
                        "type": "string",
                        "example": "fulanodetal@example.com"
                    },
                    "telefone": {
                        "type": "string",
                        "example": "5412345678"
                    }
                },
                "type": "object"
            },
            "EditarClienteRequest": {
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Fulano de Tal",
                        "nullable": true
                    },
                    "cpf_cnpj": {
                        "type": "string",
                        "example": "123.456.789-89",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "example": "fulanodetal@example.com",
                        "nullable": true
                    },
                    "telefone": {
                        "type": "string",
                        "example": "5412345678",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ListarClientesResponse": {
                "properties": {
                    "clientes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ClienteResponse"
                        }
                    }
                },
                "type": "object"
            },
            "ValidationError": {},
            "ValidationErrorResponse": {
                "properties": {
                    "errors": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        }
                    }
                },
                "type": "object"
            },
            "EntradaEstoqueRequest": {
                "properties": {
                    "id_peca": {
                        "type": "integer",
                        "example": 1
                    },
                    "quantidade": {
                        "type": "integer",
                        "example": 10
                    }
                },
                "type": "object"
            },
            "EntradaEstoqueResponse": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "id_peca": {
                        "type": "integer",
                        "example": 1
                    },
                    "peca": {
                        "type": "string",
                        "example": "Filtro de óleo"
                    },
                    "quantidade": {
                        "type": "integer",
                        "example": 10
                    },
                    "tipo_lancamento": {
                        "type": "string",
                        "example": "entrada"
                    }
                },
                "type": "object"
            }
