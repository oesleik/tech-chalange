{
    "name": "meu-projeto/app",
    "description": "Aplicação PHP com Slim Framework 4",
    "type": "project",
    "require": {
        "php": "^8.4",
        "lcobucci/jwt": "^5.6",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "phpmailer/phpmailer": "^7.1",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.0",
        "symfony/serializer-pack": "^1.4",
        "symfony/validator": "^8.1",
        "zircote/swagger-php": "^6.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
    ,
    "scripts": {
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff --using-cache=no",
        "phpstan": "vendor/bin/phpstan analyse src",
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-clover=coverage/clover.xml --coverage-html=coverage/html",
        "ci": [
            "@lint",
            "@phpstan",
            "@test:coverage"
        ]
    }
}
