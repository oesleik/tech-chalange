{
    "name": "meu-projeto/app",
    "description": "Aplicação PHP com Slim Framework 4",
    "type": "project",
    "require": {
        "php": "^8.4",
        "lcobucci/jwt": "^5.6",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.0",
        "symfony/serializer-pack": "^1.4",
        "symfony/validator": "^8.1",
        "zircote/swagger-php": "^6.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
